# Copy to `.env` at the repository root. `@day-mark/config` and Prisma both load this file.
# The Zod schema is strict: every key must be present at process start, even if a service is unused locally.

# --- Runtime ---
NODE_ENV=development
# NestJS listens on PORT (defaults to 3000 if omitted at listen-time; still set it for clarity)
PORT=3000

# --- Database (PostgreSQL + Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/daymark?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
BCRYPT_SECRET_PEPPER=replace-with-a-random-pepper

# Google OAuth (Passport). Use dummy strings only if you will not exercise Google login.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# --- Email (Resend) ---
RESEND_API=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Redis: cache vs queues ---
# Upstash (TLS) used for session-ish cache, notification prefs, XP hashes, Redlock.
UPSTASH_REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Local or dedicated Redis used by BullMQ workers and the Socket.IO Redis adapter.
# Must allow maxRetriesPerRequest=null (BullMQ requirement).
QUEUE_REDIS_URL=redis://127.0.0.1:6379

# --- MongoDB (ephemeral in-app notification inbox) ---
MONGODB_URI=mongodb://127.0.0.1:27017/daymark

# --- AWS DynamoDB (append-only logs + daily reflections) ---
AWS_IAM_ACCESS_KEY=
AWS_IAM_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
