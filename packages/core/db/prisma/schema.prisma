generator client {
  provider = "prisma-client-js"
  // output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(uuid())
  userName            String           @unique
  email               String           @unique
  avatar_url          String?
  timeZone            String           @default("UTC")
  dayStartTime        String           @default("09:00")
  isOnboarded         Boolean          @default(false)

  accounts            Account[]

  rank                String           @default("Beginner")
  level               Int              @default(1)
  xp                  Int              @default(0)

  habits              Habit[]
  goals               Goal[]
  tasks               Task[]
  xpTransactions      XpTransaction[]

  theme               ThemePreference    @default(GENERAL)
  isAppPaused         Boolean            @default(false)
  notificationPreference                 NotificationPreference?
  pushSubscriptions                      PushSubscription[]

  lastActive          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt   

  habitMonthlyLogs    HabitMonthlyLogs[]
}

enum ThemePreference {
  GENERAL
}

model Account {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                String             // "credentials", "oauth"
  provider            Provider           // "google", "github", "local"
  providerAccountId   String             // unique id from google/github/local
  password            String?
}

enum Provider {
  GOOGLE
  GITHUB
  CREDENTIALS
}

// ########-- GOAL SYSTEM -- ########

model Goal {
  id                  String             @id  @default(uuid())
  userId              String
  title               String
  description         String?
  rewardText          String?
  timeFrame           HorizonType
  weekendsExcluded    Boolean
  configeDaysPerWeek  Int                @default(5)
  monthlyWeekSprints  String[]           @default([])
  status              GoalStatus         @default(ACTIVE)

  targetDays          Int
  completedDays       Int                @default(0)
  daysSkipped         Int                @default(0)

  startDate           DateTime           @default(now())

  currentProgress     Int                @default(0)
  currentVelocity     Int                @default(100)
  totalActiveDays     Int                @default(0)

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks               Task[]

  createdAt           DateTime
  updatedTime         DateTime            @updatedAt           
  @@index([userId])
}

enum HorizonType {
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  SCHEDULED
  ABANDONED
}

// ########-- HABIT SYSTEM -- ########

model Habit {
  id                    String            @id  @default(uuid())
  userId                String 
  title                 String
  description           String
  tag                   String
  daysOfWeek            String[]    // on which days the habit should show in the task

  isActive              Boolean           @default(true)

  taskTitle             String
  taskDueTime           String
  taskPriority          PriorityLevel     @default(MEDIUM)

  currentStreak         Int               @default(0)
  longestStreak         Int               @default(0)
  stabilityScore        Int               @default(0)
  createdAt             DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks                 Task[]
  logs                  HabitMonthlyLogs[]

  @@index([userId])
  @@index([id, userId])
}

model HabitMonthlyLogs {
  id        String   @id @default(uuid())
  userId    String
  habitId   String
  yearMonth String   // Format: "2026-06"
  
  // Hardcoded default consisting of 31 'S' (Skipped) characters.
  // The user interaction flips characters to 'D' at the 0-indexed day offset.
  history   String   @default("SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS")

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, yearMonth])
  @@index([yearMonth])
}

// ########-- TASK SYSTEM -- ########

model Task {
  id                    String           @id @default(uuid())
  userId                String
  goalId                String?
  habitId               String?
  type                  TaskType         @default(Standard)
  title                 String
  status                TaskStatus       @default(PENDING)
  priority              PriorityLevel    @default(MEDIUM)
  scheduledDate         String           @default("")
  dueTime               DateTime?        @db.Timestamptz()

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                  Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit                 Habit?           @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt             DateTime         @db.Timestamptz()      @default(now())

  @@index([userId, scheduledDate])
  @@index([id, userId])
  @@index([goalId])
  @@index([habitId])
  @@unique([habitId, scheduledDate])

}

enum TaskStatus {
  PENDING
  DONE
  ABANDONED
}

enum PriorityLevel {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  Standard
  HabitTask
  GoalTask
}

// ########-- XP SYSTEM -- ########

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String   
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ########-- NOTIFICATIONS PREFS -- ########
model NotificationPreference {
  id               String             @id     @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery Channel Master Toggles
  webPushEnabled     Boolean            @default(true)
  masterNotification Boolean            @default(true)

  // Scheduled Reminder Preferences
  midDayReminder        Boolean         @default(true)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ########-- WEB PUSH NOTIFICATIONS -- ########
model PushSubscription {
  id             String           @id         @default(cuid())
  userId         String           
  endpoint       String           @unique
  p256dh         String
  auth           String
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}