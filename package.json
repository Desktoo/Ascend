{
  "name": "day-mark",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm"
  },
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*/*",
    "packages/*"
  ],
  "pnpm": {
  "onlyBuiltDependencies": [
    "bcrypt",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "prisma",
    "@prisma/engines"
  ]
}
}
